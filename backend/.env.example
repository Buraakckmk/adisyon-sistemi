PORT=3001
JWT_SECRET=replace-with-long-random-secret

# Local PostgreSQL running on the cashier computer
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=adisyon_db
DB_USER=postgres
DB_PASSWORD=postgres

DB_POOL_MIN=2
DB_POOL_MAX=30
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_APPLICATION_NAME=adisyon-backend

# Direct LAN printer IPs
PRINTER_PORT=9100
# Route-based printer targets (preferred)
PRINTER_IP_KASA=192.168.1.111
PRINTER_IP_MUTFAK=192.168.1.51
PRINTER_IP_BAR=192.168.1.52
# Legacy aliases (still supported)
KASA_PRINTER_IP=192.168.1.111
MUTFAK_PRINTER_IP=192.168.1.51
BAR_PRINTER_IP=192.168.1.52

# Nightly database backup
PG_DUMP_PATH=pg_dump
BACKUP_CRON=0 3 * * *
BACKUP_DIR=./backups
BACKUP_TIMEZONE=Europe/Istanbul